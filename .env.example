# Copy this file to .env.local and fill in the real Supabase project values.
# admin-exact connects to the SAME Supabase project as earnxact — copy the
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY values straight
# from earnxact/.env.local (Supabase dashboard: Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
